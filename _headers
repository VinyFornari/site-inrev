# Cache da home. Regras de Cache-Control não podem se sobrepor: a Pages
# junta valores repetidos com vírgula e o navegador fica com diretivas
# conflitantes. HTML revalida; JS com hash e fontes ficam imutáveis.
# CSS, imagens e RSS do blog não entram aqui e seguem o cache padrão da Pages.

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Inrev-Rule: html-file

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Inrev-Rule: home

/blog/
  Cache-Control: public, max-age=0, must-revalidate
  X-Inrev-Rule: blog-index

/blog/*/
  Cache-Control: public, max-age=0, must-revalidate
  X-Inrev-Rule: blog-splat

/politica-de-privacidade/
  Cache-Control: public, max-age=0, must-revalidate
  X-Inrev-Rule: privacy

/politica-de-cookies/
  Cache-Control: public, max-age=0, must-revalidate
  X-Inrev-Rule: cookies

/assets/app.*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/react.*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/react-dom.*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
